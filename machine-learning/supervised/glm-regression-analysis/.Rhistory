# Create binary infidelity indicator
affairs <- affairs %>%
mutate(cheat = ifelse(naffairs > 0, 1, 0))
# Basic data structure
str(affairs)
summary(affairs)
# Class distribution
cat("Binary outcome distribution:\n")
table(affairs$cheat)
prop.table(table(affairs$cheat))
# Count outcome distribution
cat("\nCount outcome distribution:\n")
table(affairs$naffairs)
