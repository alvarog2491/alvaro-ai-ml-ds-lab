require(MASS)
suppressPackageStartupMessages(library(tidyverse))
wine_df <- read_delim("data/wine_quality.csv",
delim = ";",
show_col_types = FALSE)
str(wine_df)
# Recategorize the 'quality' variable and convert to factor
wine_df <- wine_df %>%
mutate(
quality = case_when(
quality %in% c(3, 4) ~ "poor",
quality %in% c(5, 6) ~ "acceptable",
quality %in% c(7, 8) ~ "good"
),
quality = factor(quality, levels = c("poor", "acceptable", "good"))
)
# Check the changes
table(wine_df$quality)
# Normalize dataset variables to 0-1 range
suppressPackageStartupMessages(library('caret'))
process <- preProcess(wine_df, method=c("range"), rangeBounds = c(0, 1))
wine_scaled_df <- predict(process, wine_df)
str(wine_scaled_df)
library(dplyr)
# Shapiro-Wilk test for each variable and class
normality_results <- wine_scaled_df %>%
select(-quality) %>%
colnames() %>%
lapply(function(var) {
wine_scaled_df %>%
group_by(quality) %>%
summarise(
variable = var,
p_value = shapiro.test(get(var))$p.value,
.groups = "drop"
)
}) %>%
bind_rows()
normality_results
# Box's M test
boxM(
x = wine_scaled_df %>% select(-quality),
grouping = wine_scaled_df$quality
)
library(ggplot2)
library(ggplot2)
# Variables numéricas a revisar
vars <- colnames(wine_scaled_df)[colnames(wine_scaled_df) != "quality"]
# Loop para cada variable y cada clase
for (v in vars) {
for (cl in levels(wine_scaled_df$quality)) {
data_subset <- wine_scaled_df %>% filter(quality == cl)
# Histograma con curva normal superpuesta
p_hist <- ggplot(data_subset, aes_string(x = v)) +
geom_histogram(aes(y = ..density..), bins = 20, fill = "lightblue", color = "black") +
stat_function(
fun = dnorm,
args = list(mean = mean(data_subset[[v]], na.rm = TRUE),
sd = sd(data_subset[[v]], na.rm = TRUE)),
color = "red", size = 1
) +
ggtitle(paste("Histogram of", v, "for class", cl)) +
theme_minimal()
print(p_hist)
# Q-Q plot
qq <- ggplot(data_subset, aes_string(sample = v)) +
stat_qq() +
stat_qq_line(color = "red") +
ggtitle(paste("Q-Q plot of", v, "for class", cl)) +
theme_minimal()
print(qq)
}
}
library(ggplot2)
library(dplyr)
library(rlang)
vars <- colnames(wine_scaled_df)[colnames(wine_scaled_df) != "quality"]
for (v in vars) {
for (cl in levels(wine_scaled_df$quality)) {
data_subset <- wine_scaled_df %>% filter(quality == cl)
var_sym <- sym(v)  # convierte string a símbolo para aes()
# Histograma con curva normal superpuesta
p_hist <- ggplot(data_subset, aes(x = !!var_sym)) +
geom_histogram(aes(y = ..density..), bins = 20, fill = "lightblue", color = "black") +
stat_function(
fun = dnorm,
args = list(
mean = mean(data_subset[[v]], na.rm = TRUE),
sd = sd(data_subset[[v]], na.rm = TRUE)
),
color = "red", size = 1
) +
ggtitle(paste("Histogram of", v, "for class", cl)) +
theme_minimal()
print(p_hist)
# Q-Q plot
p_qq <- ggplot(data_subset, aes(sample = !!var_sym)) +
stat_qq() +
stat_qq_line(color = "red") +
ggtitle(paste("Q-Q plot of", v, "for class", cl)) +
theme_minimal()
print(p_qq)
}
}
library(dplyr)
library(ggplot2)
library(e1071)  # para la función skewness
# Calculamos skewness de cada variable (numérica, sin quality)
numeric_vars <- colnames(wine_scaled_df)[colnames(wine_scaled_df) != "quality"]
skew_values <- sapply(wine_scaled_df[numeric_vars], skewness, na.rm = TRUE)
# Variables con alto sesgo (por ejemplo, |skew| > 1)
skewed_vars <- names(skew_values[abs(skew_values) > 1])
print(skewed_vars)
# Aplicamos transformaciones solo a estas variables
wine_transformed <- wine_scaled_df
for (v in skewed_vars) {
# Para evitar problemas con ceros o negativos sumamos una pequeña constante antes del log
min_val <- min(wine_scaled_df[[v]], na.rm = TRUE)
cte <- ifelse(min_val <= 0, abs(min_val) + 1e-6, 0)
wine_transformed[[paste0(v, "_log")]] <- log(wine_scaled_df[[v]] + cte)
wine_transformed[[paste0(v, "_sqrt")]] <- sqrt(wine_scaled_df[[v]] + cte)
}
# Visualizamos histogramas de la variable original y las transformadas (ejemplo con la primera variable sesgada)
var_to_plot <- skewed_vars[1]
p1 <- ggplot(wine_transformed, aes_string(var_to_plot)) +
geom_histogram(bins = 30, fill = "skyblue", color = "black") +
ggtitle(paste("Original:", var_to_plot))
p2 <- ggplot(wine_transformed, aes_string(paste0(var_to_plot, "_log"))) +
geom_histogram(bins = 30, fill = "orange", color = "black") +
ggtitle(paste("Log transform:", paste0(var_to_plot, "_log")))
p3 <- ggplot(wine_transformed, aes_string(paste0(var_to_plot, "_sqrt"))) +
geom_histogram(bins = 30, fill = "green", color = "black") +
ggtitle(paste("Sqrt transform:", paste0(var_to_plot, "_sqrt")))
print(p1)
print(p2)
print(p3)
library(dplyr)
library(ggplot2)
library(e1071)
# Variables numéricas
numeric_vars <- colnames(wine_scaled_df)[colnames(wine_scaled_df) != "quality"]
# Calculamos skewness
skew_values <- sapply(wine_scaled_df[numeric_vars], skewness, na.rm = TRUE)
# Variables sesgadas (|skew| > 1)
skewed_vars <- names(skew_values[abs(skew_values) > 1])
print(skewed_vars)
# Aplicar transformaciones
wine_transformed <- wine_scaled_df
for (v in skewed_vars) {
min_val <- min(wine_scaled_df[[v]], na.rm = TRUE)
cte <- ifelse(min_val <= 0, abs(min_val) + 1e-6, 0)
wine_transformed[[paste0(v, "_log")]] <- log(wine_scaled_df[[v]] + cte)
wine_transformed[[paste0(v, "_sqrt")]] <- sqrt(wine_scaled_df[[v]] + cte)
}
# Función para plotear histogramas de variables con espacios usando aes_string con comillas dobles
plot_histogram <- function(df, var_name, title) {
ggplot(df) +
geom_histogram(aes(.data[[var_name]]), bins = 30, fill = "skyblue", color = "black") +
ggtitle(title)
}
# Ejemplo para la primera variable sesgada y sus transformadas
var_to_plot <- skewed_vars[1]
p1 <- plot_histogram(wine_transformed, var_to_plot, paste("Original:", var_to_plot))
p2 <- plot_histogram(wine_transformed, paste0(var_to_plot, "_log"), paste("Log transform:", paste0(var_to_plot, "_log")))
p3 <- plot_histogram(wine_transformed, paste0(var_to_plot, "_sqrt"), paste("Sqrt transform:", paste0(var_to_plot, "_sqrt")))
print(p1)
print(p2)
print(p3)
